# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local MCP config (contains secrets)
.mcp.json

# reference files (PDFs, brand assets - do not publish)
/reference

# large media and local assets - do not commit
/PDFs
/posts
/music
/editor-pro-max-main
/editor-pro-max-main.zip
/social assets
docs/reels/audio/

# typescript
*.tsbuildinfo
next-env.d.ts
